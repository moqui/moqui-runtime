                    vm.convPageIndex = body && body.pageIndex != null ? body.pageIndex : page;
                    if (body && body.pageSize) vm.convPageSize = body.pageSize;
                })
                .catch(function() { vm.conversations = []; });
        },
        toggleConvDrawer: function() {
