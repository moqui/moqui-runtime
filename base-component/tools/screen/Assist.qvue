                    if (prefs.ASSIST_WRITE_MODE === 'agent' || prefs.ASSIST_WRITE_MODE === 'script')
                        vm.writeMode = prefs.ASSIST_WRITE_MODE;
                    if (prefs.ASSIST_FORCE_SKILL_USE === 'true') vm.forceSkillUse = true;
                    if (prefs.ASSIST_FORCE_SKILL_USE === 'false') vm.forceSkillUse = false;
                } });
        },
        loadProfiles: function() {
            var vm = this;
