module.exports = {
    data: function() {
        return {
            chatOnLeft: true, writeMode: 'script', forceSkillUse: false, splitPct: 40,
            viewportWidth: typeof window !== 'undefined' ? window.innerWidth : 1200,
            mobileTab: 'chat', openGen: 0,
            composer: '', streaming: false,
            conversationId: null, canvasId: null,
            messages: [], pendingToolCalls: [],
            schema: null, fieldValues: {}, dirtyFields: {},
            adjustOpen: false, adjustText: '', canvasNotices: [],
            autoValidationCount: 0, lastAutoHash: '', maxAutoValidations: 4,
            vueSfcComp: null, vueSfcKey: null, vueSfcGen: 0, vueSfcFailed: false,
            speechSupported: false, recognizing: false,
            recognition: null, abortCtl: null,
            conversations: [], profileFlags: {},
            convDrawer: false, convSearch: '', convPageIndex: 0, convTotal: 0, convPageSize: 20,
            convSearchTimer: null, sourceOpen: false, deleteOpen: false, deleteTarget: null
