                                sessionStorage.removeItem(CONV_STORAGE_KEY);
                        } catch (e) { /* ignore */ }
                        if (vm.conversationId === id) vm.conversationId = null;
                        return null;
                    }
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(function(body) {
                    if (gen !== vm.openGen || vm.streaming) return;
                    if (body && vm.conversationId && vm.conversationId !== openedOver
                            && vm.conversationId !== body.conversationId) return;
                    if (!body || !body.conversationId) return;
                    vm.restoreConversation(body);
                })
                .catch(function(err) { assistNotify((err && err.message) || 'Could not open conversation', 'warning'); });
        },
        restoreConversation: function(body) {
            this.conversationId = body.conversationId;
            try { sessionStorage.setItem(CONV_STORAGE_KEY, body.conversationId); } catch (e) { /* ignore */ }
            this.messages = historyToMessages(body.history);
            this.pendingToolCalls = body.pendingToolCalls || [];
            this.schema = null;
            this.fieldValues = {};
            this.dirtyFields = {};
            this.canvasNotices = [];
            this.adjustOpen = false;
            this.adjustText = '';
            this.autoValidationCount = 0;
            this.lastAutoHash = '';
            this.vueSfcComp = null;
            this.vueSfcKey = null;
            this.vueSfcFailed = false;
            this.vueSfcGen = (this.vueSfcGen || 0) + 1;
            var canvas = body.canvas;
            if (!canvas) {
                var pending = this.pendingToolCalls[0];
                var args = pending && pending.name === 'write_ui' ? pending.arguments : null;
                if (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = null; } }
                if (isWriteUiArgs(args)) canvas = args;
            }
            if (canvas) this.applyYield(canvas);
            this.convDrawer = false;
        },
        askDelete: function(row) {
            this.deleteTarget = row;
            this.deleteOpen = true;
        },
        deleteConversation: function() {
            var row = this.deleteTarget;
            if (!row || !row.conversationId) return;
            var vm = this;
            var id = row.conversationId;
            this.deleteOpen = false;
            fetch(this.llmBase + '/conversations/' + encodeURIComponent(id), {
                method: 'DELETE', credentials: 'same-origin', headers: this.headers(false), body: '{}'
            }).then(function(r) {
                return r.json().catch(function() { return {}; }).then(function(body) {
                    if (!r.ok || body.deleted === false) {
                        assistNotify((body && body.message) || 'Could not delete', 'warning');
                        return;
                    }
                    if (vm.conversationId === id) {
                        vm.openGen = (vm.openGen || 0) + 1;
                        vm.clearLocalSession();
                    }
                    vm.loadConversations(vm.convPageIndex || 0);
                });
            }).catch(function(err) { assistNotify((err && err.message) || 'Could not delete', 'warning'); });
        },
        copyText: function(text) {
            if (!text) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).catch(function() { /* ignore */ });
            }
        },
        formatWhen: function(ms) { return formatWhen(ms); },
        convStatusLabel: function(status) { return convStatusLabel(status); },
        send: function() {
            var text = (this.composer || '').trim();
            if (!text || this.streaming) return;
            this.composer = '';
            this.messages.push({ role: 'user', content: text });
            if (this.pendingToolCalls.length) this.resumeChat(text);
            else this.chat(text);
        },
        toolNames: function() { return ['find_skill', 'enter_sim', 'browse', 'request', 'write_ui', 'run_service']; },
        headers: function(stream) {
            var h = { 'Content-Type': 'application/json', 'X-CSRF-Token': this.csrf, Accept: stream ? 'text/event-stream' : 'application/json' };
            return h;
        },
        chatFlags: function() {
            return {
                forceSkillUse: !!this.forceSkillUse,
                writeMode: this.writeMode === 'agent' ? 'agent' : 'script'
            };
        },
        chat: function(text) {
            var body = Object.assign({ profile: 'assist', purpose: 'assist', canvasId: this.canvasId,
                user: text, tools: this.toolNames(), stream: true }, this.chatFlags());
            if (this.conversationId) body.conversationId = this.conversationId;
            this.runSse(this.llmBase + '/chat', body);
        },
        resumeChat: function(text) {
            var pending = this.pendingToolCalls[0];
            if (!pending) { this.chat(text); return; }
            var content = this.writeUiResult(false, null);
            content.userMessage = text;
            var body = Object.assign({ profile: 'assist', tools: this.toolNames(), user: text, stream: true,
                toolResults: [{ id: pending.id, name: pending.name || 'write_ui', content: content }] },
                this.chatFlags());
            this.runSse(this.llmBase + '/chat/' + encodeURIComponent(this.conversationId) + '/resume', body);
        },
        writeUiResult: function(submitted, button) {
            return {
                submitted: !!submitted,
                mode: this.writeMode,
                button: button || null,
                values: Object.assign({}, this.fieldValues),
                actions: (this.schema && this.schema.actions) || [],
                canvas: this.currentCanvas()
            };
        },
        recordCanvasNotice: function(message, kind) {
            if (!message) return false;
            var text = String(message);
            var norm = text.trim().replace(/\s+/g, ' ');
            var list = this.canvasNotices || [];
            this.canvasNotices = list;
            for (var i = 0; i < list.length; i++) {
                var existing = list[i];
                var existingNorm = String(existing.message || '').trim().replace(/\s+/g, ' ');
                if (existingNorm === norm) {
                    existing.count = (existing.count || 1) + 1;
                    return false;
                }
            }
            list.push({ kind: kind === 'error' ? 'error' : (kind || 'warning'), message: text, count: 1 });
            return true;
        },
        noteCanvas: function(message, kind) {
            if (this.recordCanvasNotice(message, kind)) assistNotify(message, kind);
        },
        adjustPackage: function(feedback) {
            var canvas = this.currentCanvas();
            var fields = (canvas && canvas.fields) || [];
            for (var i = 0; i < fields.length; i++) {
                var f = fields[i];
                if (f && sensitiveValueKey(f.name) && f.defaultValue != null && f.defaultValue !== '')
                    f.defaultValue = '***';
            }
            var pack = {
                submitted: false,
                adjust: true,
                feedback: feedback,
                instruction: ADJUST_INSTRUCTION,
                mode: this.writeMode,
                button: null,
                values: redactValueMap(this.fieldValues),
                actions: (this.schema && this.schema.actions) || [],
                canvas: canvas
            };
            var notices = this.canvasNotices || [];
            if (notices.length) {
                pack.notices = notices.map(function(n) {
                    var row = { kind: n.kind, message: n.message };
                    if (n.count && n.count > 1) row.count = n.count;
                    return row;
                });
            }
            return pack;
        },
        submitAdjust: function() {
            var feedback = (this.adjustText || '').trim();
            var pending = this.pendingToolCalls && this.pendingToolCalls[0];
            if (!feedback || this.streaming || !this.schema || this.pendingConfirm()) return;
            if (pending && pending.name !== 'write_ui') return;
            this.adjustOpen = false;
            this.adjustText = '';
            var pack = this.adjustPackage(feedback);
            this.messages.push({ role: 'user', content: 'Adjust: ' + feedback });
            if (pending && pending.name === 'write_ui' && this.conversationId) {
                pack.userMessage = feedback;
                var body = Object.assign({ profile: 'assist', tools: this.toolNames(), user: feedback, stream: true,
                    toolResults: [{ id: pending.id, name: 'write_ui', content: pack }] },
                    this.chatFlags());
                this.runSse(this.llmBase + '/chat/' + encodeURIComponent(this.conversationId) + '/resume', body);
                return;
            }
            var userText = 'Adjust the screen.\n' + ADJUST_INSTRUCTION
                + '\n\nFeedback:\n' + feedback
                + '\n\nwrite_ui result:\n' + JSON.stringify(pack);
            this.chat(userText);
        },
        currentCanvas: function() {
            var schema = this.schema ? JSON.parse(JSON.stringify(this.schema)) : null;
            if (!schema) return null;
            var vals = this.fieldValues;
            var fields = schema.fields || [];
            for (var i = 0; i < fields.length; i++) {
                var n = fields[i].name;
                if (n && Object.prototype.hasOwnProperty.call(vals, n)) fields[i].defaultValue = vals[n];
            }
            return schema;
        },
        applySchema: function(schema) {
            if (!schema) return;
            this.canvasNotices = [];
            var prevDirty = Object.assign({}, this.dirtyFields);
            var prevVals = Object.assign({}, this.fieldValues);
            schema.title = unescapeHtml(schema.title);
            schema.instruction = unescapeHtml(schema.instruction);
            if (schema.instruction && /root\s*=\s*Stack\s*\(/.test(schema.instruction))
                schema.instruction = '';
            schema.submitLabel = unescapeHtml(schema.submitLabel);
            var acts = schema.actions || [];
            for (var ai = 0; ai < acts.length; ai++) if (acts[ai] && acts[ai].label)
                acts[ai].label = unescapeHtml(acts[ai].label);
            var flds = schema.fields || [];
            for (var fi = 0; fi < flds.length; fi++) if (flds[fi] && flds[fi].label)
                flds[fi].label = unescapeHtml(flds[fi].label);
            this.schema = schema;
            if (schema.sfcError) this.noteCanvas(schema.sfcError, 'error');
            if (schema.langError && schema.kind === 'openui' && !schema.lang)
                this.noteCanvas(schema.langError, 'error');
            var next = {};
            var fields = schema.fields || [];
            for (var i = 0; i < fields.length; i++) {
                var f = fields[i];
                if (!f || !f.name) continue;
                if (prevDirty[f.name]) next[f.name] = prevVals[f.name];
                else if (f.widget === 'date-time')
                    next[f.name] = assistFormatDateValue(scalarValue(f.defaultValue), f.widgetType || 'date-time');
                else next[f.name] = scalarValue(f.defaultValue);
            }
            Object.keys(prevVals).forEach(function(k) {
                if (!Object.prototype.hasOwnProperty.call(next, k)) next[k] = prevVals[k];
            });
            this.fieldValues = next;
            this.dirtyFields = prevDirty;
        },
        applyYield: function(args) {
            if (!args) return;
            this.autoValidationCount = 0;
            this.lastAutoHash = '';
            this.applySchema(args);
            if (args.kind === 'openui') {
                this.vueSfcGen = (this.vueSfcGen || 0) + 1;
                this.vueSfcComp = null;
                this.vueSfcKey = null;
                this.vueSfcFailed = false;
                this.loadOpenUi();
            } else if (args.kind === 'vue-sfc') this.loadVueSfc(args);
            else {
                this.vueSfcGen = (this.vueSfcGen || 0) + 1;
                this.vueSfcComp = null;
                this.vueSfcKey = null;
                this.vueSfcFailed = false;
            }
        },
        loadOpenUi: function() {
            if (window.OpenUILang && window.AssistOpenUiReady) return Promise.resolve();
            var root = (this.$root && this.$root.appRootPath) || '';
            var ver = pageResourceVersion();
            var q = ver ? ('?v=' + ver) : '';
            var files = [
                root + '/js/assist/lang-core.umd.min.js' + q,
                root + '/js/assist/AssistOpenUiLibrary.js' + q,
                root + '/js/assist/AssistOpenUi.js' + q
            ];
            var chain = Promise.resolve();
            files.forEach(function(src) {
                chain = chain.then(function() { return loadScriptOnce(src); });
            });
            var vm = this;
            return chain.catch(function(err) {
                vm.noteCanvas((err && err.message) || String(err), 'error');
            });
        },
        onOpenUiState: function(snap) {
            if (!snap || typeof snap !== 'object') return;
            var next = Object.assign({}, this.fieldValues);
            Object.keys(snap).forEach(function(k) {
                var v = snap[k];
                if (v && typeof v === 'object' && !Array.isArray(v) && typeof v.k === 'string') return;
                if (v && typeof v === 'object' && !Array.isArray(v) && Object.prototype.hasOwnProperty.call(v, 'value'))
                    v = v.value;
                if (k.charAt(0) === '$') next[k.slice(1)] = v;
                else if (v && typeof v === 'object' && !Array.isArray(v)) {
                    Object.keys(v).forEach(function(fk) {
                        var fv = v[fk];
                        if (fv && typeof fv === 'object' && Object.prototype.hasOwnProperty.call(fv, 'value')) fv = fv.value;
                        next[fk] = fv;
                    });
                } else next[k] = v;
            });
            this.fieldValues = next;
        },
        onOpenUiRequestNotice: function(payload) {
            if (!payload) return;
            var errors = payload.errors || [];
            var warnings = payload.warnings || [];
            for (var i = 0; i < errors.length; i++) this.noteCanvas(errors[i], 'error');
            for (var w = 0; w < warnings.length; w++) this.noteCanvas(warnings[w], 'warning');
            if (errors.length) this.maybeAutoResumeValidation();
        },
        onOpenUiError: function(errors) {
            if (!errors || !errors.length) return;
            var seen = {};
            var distinct = [];
            for (var i = 0; i < errors.length; i++) {
                var msg = (errors[i] && errors[i].message) || 'OpenUI parse error';
                var norm = String(msg).trim().replace(/\s+/g, ' ');
                if (seen[norm]) continue;
                seen[norm] = true;
                distinct.push(errors[i]);
            }
            if (!distinct.length) return;
            for (var d = 0; d < distinct.length; d++)
                this.recordCanvasNotice((distinct[d] && distinct[d].message) || 'OpenUI parse error', 'error');
            assistNotify(distinct.length + ' screen problem' + (distinct.length > 1 ? 's' : '') + ': '
                + ((distinct[0] && distinct[0].message) || 'OpenUI parse error'), 'warning');
            this.maybeAutoResumeValidation();
        },
        autoValidationHash: function() {
            var list = this.canvasNotices || [];
            var errs = [];
            for (var i = 0; i < list.length; i++) if (list[i] && list[i].kind === 'error') errs.push(String(list[i].message || ''));
            errs.sort();
            return errs.join('\n');
        },
        buildValidationSnippet: function() {
            var lang = this.schema && this.schema.lang;
            if (!lang) return null;
            var lines = String(lang).split('\n');
            var firstErr = null;
            var list = this.canvasNotices || [];
            for (var i = 0; i < list.length; i++) {
                if (list[i] && list[i].kind === 'error' && list[i].message) { firstErr = String(list[i].message); break; }
            }
            var at = -1;
            if (firstErr) {
                var m = /`([^`=\n]{1,64})`/.exec(firstErr) || /["']([A-Za-z_][A-Za-z0-9_]{0,63})["']/.exec(firstErr);
                if (m) {
                    var name = m[1];
                    for (var li = 0; li < lines.length; li++) {
                        if (lines[li].match(new RegExp('(^|\\s)' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*='))) { at = li; break; }
                    }
                }
            }
            var start, end;
            if (at >= 0) { start = Math.max(0, at - 2); end = Math.min(lines.length, at + 3); }
            else { start = 0; end = Math.min(lines.length, 15); }
            return { statementHint: firstErr, startLine: start + 1, lines: lines.slice(start, end), langChars: String(lang).length };
        },
        autoValidationPackage: function(feedback) {
            var pack = this.adjustPackage(feedback);
            pack.autoValidation = true;
            pack.origin = 'auto-validation';
            pack.attempt = (this.autoValidationCount || 0) + 1;
            pack.maxAttempts = this.maxAutoValidations || 4;
            var snippet = this.buildValidationSnippet();
            if (snippet) pack.snippet = snippet;
            var notices = this.canvasNotices || [];
            if (notices.length) {
                pack.notices = notices.map(function(n) {
                    var row = { kind: n.kind, message: n.message };
                    if (n.count && n.count > 1) row.count = n.count;
                    return row;
                });
            }
            return pack;
        },
        maybeAutoResumeValidation: function() {
            if (this.streaming) return;
            var pending = this.pendingToolCalls && this.pendingToolCalls[0];
            if (!pending || pending.name !== 'write_ui' || !this.conversationId) return;
            if (this.pendingConfirm()) return;
            var hash = this.autoValidationHash();
            if (!hash) return;
            var max = this.maxAutoValidations || 4;
            if ((this.autoValidationCount || 0) >= max) return;
            if (hash === this.lastAutoHash) return;
            this.lastAutoHash = hash;
            this.autoValidationCount = (this.autoValidationCount || 0) + 1;
            var n = this.autoValidationCount;
            var firstLine = hash.split('\n')[0] || 'validation failed';
            var errCount = hash.split('\n').length;
            var feedback = 'OpenUI validation failed (attempt ' + n + '/' + max + '): '
                + errCount + ' problem' + (errCount > 1 ? 's' : '') + '. First: ' + firstLine
                + '. Fix all notices with write_ui (prefer a small writeThrough patch, or a full lang program if the screen failed to render).';
            var pack = this.autoValidationPackage(feedback);
            pack.userMessage = feedback;
            this.messages.push({ role: 'user', content: 'Auto-adjust (validation ' + n + '/' + max + '): ' + firstLine });
            assistNotify('Checking screen, attempt ' + n + '/' + max + '…', 'info');
            if (n >= max) {
                var vm = this;
                setTimeout(function() {
                    assistNotify('Validation still failing after ' + max + ' attempts — ' + errCount
                        + ' problems listed; use Adjust or edit the request.', 'warning');
                }, 0);
            }
            var body = Object.assign({ profile: 'assist', tools: this.toolNames(), user: feedback, stream: true,
                toolResults: [{ id: pending.id, name: 'write_ui', content: pack }] },
                this.chatFlags());
            this.runSse(this.llmBase + '/chat/' + encodeURIComponent(this.conversationId) + '/resume', body);
        },
        onOpenUiAction: function(ev) {
            if (!ev) return;
            if (ev.formState) this.onOpenUiState(ev.formState);
            var type = ev.type;
            if (type === 'open_url') {
                var url = ev.params && ev.params.url;
                var Nav = window.AssistOpenUiNav;
                var built = Nav && Nav.build ? Nav.build(url, null, null, {
                    appRoot: (this.$root && this.$root.appRootPath) || '',
                    getLinkPath: this.$root && this.$root.getLinkPath && this.$root.getLinkPath.bind(this.$root),
                    rewriteShell: true
                }) : null;
                if (built && built.href) window.open(built.href, '_blank', 'noopener,noreferrer');
                else if (!built && url && url.charAt(0) === '/' && url.indexOf('://') < 0 && url.indexOf('//') !== 0
                        && url.indexOf('..') < 0)
                    window.open(((this.$root && this.$root.appRootPath) || '') + url, '_blank', 'noopener,noreferrer');
                return;
            }
            if (type === 'submit' || type === 'continue_conversation') {
                if (ev.humanFriendlyMessage && type === 'continue_conversation' && this.pendingToolCalls.length)
                    this.resumeChat(ev.humanFriendlyMessage);
                else this.submitCanvas(this.primaryId);
            }
        },
        applyOpenUiDelta: function(argumentsSoFar) {
            var lang = extractOpenUiLang(argumentsSoFar);
            if (!lang) return;
            if (!this.schema || this.schema.kind === 'openui' || !this.schema.kind) {
                var next = Object.assign({}, this.schema || {}, { kind: 'openui', lang: lang });
                this.schema = next;
                this.loadOpenUi();
            }
        },
        loadVueSfc: function(schema) {
            var vm = this;
            var text = assembleSfc(schema);
            if (!text || text.toLowerCase().indexOf('<template') < 0) {
                this.vueSfcGen = (this.vueSfcGen || 0) + 1;
                if (!this.vueSfcComp) this.vueSfcFailed = true;
                if (schema && schema.sfcError) vm.noteCanvas(schema.sfcError, 'error');
                return;
            }
            var key = hashString(text);
            if (key === this.vueSfcKey && this.vueSfcComp) { this.vueSfcFailed = false; return; }
            if (typeof httpVueLoader === 'undefined' || !httpVueLoader.parse) {
                vm.noteCanvas('Generated screen failed to compile: httpVueLoader is not available', 'error');
                if (!this.vueSfcComp) this.vueSfcFailed = true;
                return;
            }
            this.vueSfcFailed = false;
            this.vueSfcGen = (this.vueSfcGen || 0) + 1;
            var gen = this.vueSfcGen;
            var parsed;
            try { parsed = httpVueLoader.parse(text, ''); }
            catch (e) {
                vm.noteCanvas('Generated screen failed to compile: ' + ((e && e.message) || String(e)), 'error');
                if (!this.vueSfcComp) this.vueSfcFailed = true;
                return;
            }
            Promise.resolve(typeof parsed === 'function' ? parsed() : parsed).then(function(comp) {
                if (gen !== vm.vueSfcGen) return;
                if (!comp || !comp.template) {
                    vm.noteCanvas('Generated screen failed to compile: missing template', 'error');
                    if (!vm.vueSfcComp) vm.vueSfcFailed = true;
                    return;
                }
                vm.vueSfcComp = ensureSfcProps(comp);
                vm.vueSfcKey = key;
                vm.vueSfcFailed = false;
            }).catch(function(err) {
                if (gen !== vm.vueSfcGen) return;
                vm.noteCanvas('Generated screen failed to compile: ' + ((err && err.message) || String(err)), 'error');
                if (!vm.vueSfcComp) vm.vueSfcFailed = true;
            });
        },
        onSfcInput: function(payload) {
            if (payload == null || typeof payload !== 'object' || Array.isArray(payload)) return;
            if (payload.name != null && Object.prototype.hasOwnProperty.call(payload, 'value')
                    && Object.keys(payload).length <= 3)
                this.onFieldInput(payload.name, payload.value);
            else {
                var vm = this;
                Object.keys(payload).forEach(function(k) {
                    if (k === 'name' || k === 'button') return;
                    vm.onFieldInput(k, payload[k]);
                });
                if (payload.name != null && payload.value !== undefined && !Object.prototype.hasOwnProperty.call(payload, payload.name))
                    this.onFieldInput(payload.name, payload.value);
            }
        },
        onSfcSubmit: function(payload) {
            var button = this.primaryId;
            if (payload && typeof payload === 'object') {
                if (payload.button) button = payload.button;
                if (payload.values && typeof payload.values === 'object') this.onSfcInput(payload.values);
                else if (payload.name != null && Object.prototype.hasOwnProperty.call(payload, 'value'))
                    this.onSfcInput(payload);
            }
            this.submitCanvas(button);
        },
        radioOptions: function(f) {
            return ((f && f.options) || []).map(function(o) {
                return { label: (o && (o.text || o.key)) || '', value: o && o.key };
            });
        },
        onFieldInput: function(name, value) {
            this.$set(this.fieldValues, name, value);
            this.$set(this.dirtyFields, name, true);
        },
        submitCanvas: function(buttonId) {
            if (this.streaming) return;
            var vm = this;
            var acts = (this.schema && this.schema.actions) || [];
            var runActions = this.writeMode === 'script' && acts.length;
            assistNotify(runActions ? 'Running listed actions…' : 'Submitted — Assist is working…', 'info');
            if (runActions) {
                this.runScriptActions().then(function(actionResults) {
                    assistNotify('Actions finished; Assist is reviewing results…', 'info');
                    vm.finishSubmit(buttonId, actionResults);
                }).catch(function(err) {
                    var msg = (err && err.message) || String(err);
                    if (vm.recordCanvasNotice(msg, 'error')) assistNotify(msg, 'error');
                    vm.finishSubmit(buttonId, err.actionResults || []);
                });
            } else {
                this.finishSubmit(buttonId, []);
            }
        },
        pendingConfirm: function() {
            var call = this.pendingToolCalls && this.pendingToolCalls[0];
            if (!call || (call.confirm !== true && call.confirm !== 'true')) return null;
            if (call.name !== 'request' && call.name !== 'run_service') return null;
            return call;
        },
        confirmSummary: function(call) {
            if (!call) return '';
            var args = call.arguments;
            if (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = {}; } }
            args = args || {};
            var line = call.name === 'run_service'
                ? (args.serviceName || 'run_service')
                : ((args.method || 'POST') + ' ' + (args.path || ''));
            var detail = this.confirmArgs(args);
            return (call.risk === 'irreversible' ? 'Irreversible. ' : '') + line + (detail ? '\n' + detail : '');
        },
        confirmArgs: function(args) {
            var lines = [];
            function add(prefix, obj, depth) {
                if (!obj || typeof obj !== 'object' || depth > 2) return;
                Object.keys(obj).forEach(function(k) {
                    if (k === 'method' || k === 'path' || k === 'serviceName') return;
                    var v = obj[k];
                    if (/password|secret|cardnumber|cvv|apikey|authorization/i.test(k)) {
                        lines.push(prefix + k + ': (hidden)');
                        return;
                    }
                    if (v && typeof v === 'object') add(prefix + k + '.', v, depth + 1);
                    else if (v != null && v !== '') lines.push(prefix + k + ': ' + v);
                });
            }
            add('', args.parameters || {}, 0);
            add('', args.body || {}, 0);
            add('', args.query || {}, 0);
            var text = lines.join('\n');
            if (text.length > 4000) text = text.substring(0, 4000) + '…';
            return text;
        },
        confirmTool: function(ok) {
            var pending = this.pendingConfirm();
            if (!pending || !this.conversationId || this.streaming) return;
            var body = Object.assign({ profile: 'assist', tools: this.toolNames(), stream: true,
                toolResults: [{ id: pending.id, name: pending.name, content: { confirmed: !!ok } }] },
                this.chatFlags());
            this.runSse(this.llmBase + '/chat/' + encodeURIComponent(this.conversationId) + '/resume', body);
        },
        finishSubmit: function(buttonId, actionResults) {
            var pending = this.pendingToolCalls[0];
            if (!pending || !this.conversationId) {
                assistNotify('Nothing to submit (no yielded form).', 'warning');
                return;
            }
            var content = this.writeUiResult(true, buttonId);
            content.actionResults = actionResults || [];
            var body = Object.assign({ profile: 'assist', tools: this.toolNames(), stream: true,
                toolResults: [{ id: pending.id, name: pending.name || 'write_ui', content: content }] },
                this.chatFlags());
            this.runSse(this.llmBase + '/chat/' + encodeURIComponent(this.conversationId) + '/resume', body);
        },
        runScriptActions: function() {
            var vm = this;
            var actions = (this.schema && this.schema.actions) || [];
            var bag = Object.assign({}, this.fieldValues);
            var results = [];
            var failed = {};
            function next(i) {
                if (i >= actions.length) return Promise.resolve(results);
                var act = actions[i] || {};
                var deps = act.dependsOn || [];
                for (var d = 0; d < deps.length; d++) {
                    if (failed[deps[d]]) {
                        results.push({ id: act.id, skipped: true, reason: 'dependency failed: ' + deps[d] });
                        return next(i + 1);
                    }
                }
                var path = subst(act.path, bag);
                var pathErr = validateActionPath(path);
                if (pathErr) {
                    failed[act.id] = true;
                    results.push({ id: act.id, error: pathErr });
                    return Promise.reject({ message: pathErr, actionResults: results });
                }
                var method = (act.method || 'POST').toUpperCase();
                var bodyObj = {};
                var keys = act.bodyFromFields || Object.keys(vm.fieldValues);
                for (var k = 0; k < keys.length; k++) {
                    var key = keys[k];
                    if (bag[key] != null) bodyObj[key] = bag[key];
                }
                var bind = act.bind || [];
                for (var b = 0; b < bind.length; b++) if (bag[bind[b]] != null) bodyObj[bind[b]] = bag[bind[b]];
                var url = ((vm.$root && vm.$root.appRootPath) || '') + path;
                var init = { method: method, credentials: 'same-origin',
                    headers: { 'Accept': 'application/json', 'X-CSRF-Token': vm.csrf } };
                if (method !== 'GET' && method !== 'HEAD') {
                    init.headers['Content-Type'] = 'application/json';
                    init.body = JSON.stringify(bodyObj);
                } else {
                    var q = [];
                    var qf = act.queryFromFields;
                    if (!qf || !qf.length) qf = Object.keys(vm.fieldValues);
                    for (var qi = 0; qi < qf.length; qi++) {
                        var qk = qf[qi];
                        if (bag[qk] != null && bag[qk] !== '') q.push(encodeURIComponent(qk) + '=' + encodeURIComponent(bag[qk]));
                    }
                    if (q.length) url += (url.indexOf('?') >= 0 ? '&' : '?') + q.join('&');
                }
                return fetch(url, init).then(function(r) {
                    return r.text().then(function(txt) {
                        var ct = r.headers && r.headers.get ? r.headers.get('Content-Type') : null;
                        if (isHtmlBody(txt, ct)) {
                            failed[act.id] = true;
                            results.push({ id: act.id, status: r.status, error: HTML_ACTION_ERROR });
                            vm.noteCanvas(HTML_ACTION_ERROR, 'error');
                            var htmlErr = new Error((act.label || act.id) + ' returned HTML, not JSON');
                            htmlErr.actionResults = results;
                            throw htmlErr;
                        }
                        var parsed = txt;
                        try { parsed = JSON.parse(txt); } catch (e) { /* keep */ }
                        var problems = screenResponseProblems(parsed);
                        for (var wi = 0; wi < problems.warnings.length; wi++)
                            vm.noteCanvas(problems.warnings[wi], 'warning');
                        var failedMsg = null;
                        if (problems.errors.length) failedMsg = problems.errors.join('\n');
                        else if (r.status >= 400) failedMsg = (act.label || act.id) + ' failed: ' + r.status;
                        var row = { id: act.id, status: r.status, body: parsed };
                        if (failedMsg) row.error = failedMsg;
                        results.push(row);
                        if (failedMsg) {
                            failed[act.id] = true;
                            if (problems.errors.length) {
                                for (var ei = 0; ei < problems.errors.length; ei++)
                                    vm.noteCanvas(problems.errors[ei], 'error');
                            } else vm.noteCanvas(failedMsg, 'error');
                            var err = new Error(failedMsg);
                            err.actionResults = results;
                            throw err;
                        }
                        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                            Object.keys(parsed).forEach(function(pk) {
                                if (!RESPONSE_ENVELOPE[pk]) bag[pk] = parsed[pk];
                            });
                        }
                        return next(i + 1);
                    });
                });
            }
            return next(0);
        },
        runSse: function(url, body) {
            var vm = this;
            // A turn replaces an in-flight open, same as New.
            this.openGen = (this.openGen || 0) + 1;
            this.streaming = true;
            this.abortCtl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
            var assistant = { role: 'assistant', content: '', pending: true, connected: false };
            this.messages.push(assistant);
            fetch(url, {
                method: 'POST', credentials: 'same-origin',
                headers: this.headers(true),
                body: JSON.stringify(body),
                signal: this.abortCtl ? this.abortCtl.signal : undefined
            }).then(function(resp) {
                if (!resp.ok && resp.status !== 200) {
                    return resp.json().catch(function() { return {}; }).then(function(err) {
                        throw new Error(err.message || ('HTTP ' + resp.status));
                    });
                }
                if (!resp.body || !resp.body.getReader) {
                    return resp.json().then(function(j) { vm.handleJsonTurn(j, assistant); });
                }
                var reader = resp.body.getReader();
                var decoder = new TextDecoder('utf-8');
                var buf = '';
                function pump() {
                    return reader.read().then(function(chunk) {
                        if (chunk.done) {
                            vm.streaming = false;
                            vm.loadConversations(vm.convPageIndex || 0);
                            return;
                        }
                        buf += decoder.decode(chunk.value, { stream: true });
                        buf = parseSseChunk(buf, function(event, data) { vm.onSse(event, data, assistant); });
                        return pump();
                    });
                }
                return pump();
            }).catch(function(err) {
                vm.streaming = false;
                if (err && err.name === 'AbortError') return;
                var msg = (err && err.message) || String(err);
                assistNotify(msg, 'warning');
                assistant.content = assistant.content || msg;
            });
        },
        onSse: function(event, data, assistant) {
            if (event === 'conversation' && data && data.conversationId) {
                var first = !this.conversationId;
                this.conversationId = data.conversationId;
                try { sessionStorage.setItem(CONV_STORAGE_KEY, data.conversationId); } catch (e) { /* ignore */ }
                if (first) this.maybeTitle();
            } else if (event === 'llm') {
                assistant.connected = true;
            } else if (event === 'delta' && data && data.content) {
                assistant.content = (assistant.content || '') + data.content;
            } else if (event === 'write_ui_delta') {
                this.applyOpenUiDelta(data && data.arguments);
            } else if (event === 'tool_call') {
                this.messages.push({ role: 'tool', kind: 'call', name: data && data.name,
                    arguments: data && data.arguments, summary: data && data.summary });
            } else if (event === 'tool_result') {
                this.messages.push({ role: 'tool', kind: 'result', name: data && data.name,
                    content: data && data.content, summary: data && data.summary });
            } else if (event === 'yield') {
                this.pendingToolCalls = (data && data.pendingToolCalls) || [];
                var call = this.pendingToolCalls[0];
                var args = call && call.arguments;
                if (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = null; } }
                if (isWriteUiArgs(args)) this.applyYield(args);
                // FUTURE: args.kind === 'screen-xml' → POST to a compile/render transition (server round-trip)
                this.streaming = false;
                this.loadConversations(this.convPageIndex || 0);
            } else if (event === 'done') {
                this.streaming = false;
                if (data && !data.yielded) this.pendingToolCalls = [];
                var doneLine = formatDoneLine(data);
                if (doneLine) this.messages.push({ role: 'done', content: doneLine });
                this.loadConversations(this.convPageIndex || 0);
            } else if (event === 'error') {
                this.streaming = false;
                assistNotify((data && data.message) || 'LLM error', 'warning');
            }
        },
        handleJsonTurn: function(j, assistant) {
            this.streaming = false;
            if (j.conversationId) this.conversationId = j.conversationId;
            if (j.content) assistant.content = j.content;
            if (j.yielded && j.pendingToolCalls) {
                this.pendingToolCalls = j.pendingToolCalls;
                var call = this.pendingToolCalls[0];
                var args = call && call.arguments;
                if (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = null; } }
                if (isWriteUiArgs(args)) this.applyYield(args);
            }
            var doneLine = formatDoneLine(j);
            if (doneLine) this.messages.push({ role: 'done', content: doneLine });
            this.loadConversations(this.convPageIndex || 0);
        },
        maybeTitle: function() {
            if (!this.conversationId) return;
            var first = this.messages.filter(function(m) { return m.role === 'user'; })[0];
            if (!first || !first.content) return;
            var title = first.content.length > 80 ? first.content.slice(0, 77) + '...' : first.content;
            $.ajax({ type: 'POST', url: 'setTitle', dataType: 'json',
                data: { moquiSessionToken: this.csrf, conversationId: this.conversationId, title: title } });
        },
        clearLocalSession: function() {
            this.conversationId = null;
            try { sessionStorage.removeItem(CONV_STORAGE_KEY); } catch (e) { /* ignore */ }
            this.canvasId = 'c' + Date.now();
            this.messages = [];
            this.pendingToolCalls = [];
            this.schema = null;
            this.fieldValues = {};
            this.dirtyFields = {};
            this.canvasNotices = [];
            this.adjustOpen = false;
            this.adjustText = '';
            this.autoValidationCount = 0;
            this.lastAutoHash = '';
            this.vueSfcComp = null;
            this.vueSfcKey = null;
            this.vueSfcFailed = false;
            this.vueSfcGen = (this.vueSfcGen || 0) + 1;
        },
        cancelTurn: function() {
            var inFlight = this.streaming;
            if (inFlight && this.abortCtl) try { this.abortCtl.abort(); } catch (e) { /* ignore */ }
            if (!inFlight) this.abortCtl = null;
            this.streaming = false;
            if (!inFlight || !this.conversationId) return;
            fetch(this.llmBase + '/chat/' + encodeURIComponent(this.conversationId) + '/cancel', {
                method: 'POST', credentials: 'same-origin',
                headers: this.headers(false), body: '{}'
            }).catch(function() { /* ignore */ });
        },
        setupSpeech: function() {
            var Rec = window.SpeechRecognition || window.webkitSpeechRecognition;
            this.speechSupported = !!Rec;
            if (!Rec) return;
            var rec = new Rec();
            rec.lang = (navigator.language || 'en-US');
            rec.interimResults = false;
            var vm = this;
            rec.onresult = function(ev) {
                var t = ev.results && ev.results[0] && ev.results[0][0] && ev.results[0][0].transcript;
                if (t) vm.composer = (vm.composer ? vm.composer + ' ' : '') + t;
            };
            rec.onend = function() { vm.recognizing = false; };
            this.recognition = rec;
        },
        toggleMic: function() {
            if (!this.recognition) return;
            if (this.recognizing) { this.recognition.stop(); this.recognizing = false; }
            else { this.recognition.start(); this.recognizing = true; }
        },
        widgetComponent: function(widget) {
            if (widget === 'text-area') return 'q-input';
            if (widget === 'drop-down') return 'q-select';
            if (widget === 'date-time') return 'm-date-time';
            if (widget === 'display' || widget === 'display-entity') return 'div';
            return 'm-text-line';
        },
        toolSummary: function(m) {
            if (!m) return '';
            if (m.summary) return m.summary;
            if (m.kind === 'call') return formatArgsFallback(m.name, m.arguments);
            if (m.kind === 'result') return formatResultFallback(m.name, m.content);
            return '';
        }
    },
    mounted: function() {
        this.canvasId = 'c' + Date.now();
        this.loadPrefs();
        this.loadProfiles();
        this.loadConversations(0);
        var saved = null;
        try { saved = sessionStorage.getItem(CONV_STORAGE_KEY); } catch (e) { /* ignore */ }
        if (saved) this.openConversation(saved);
        this.setupSpeech();
        var vm = this;
        this.onViewport = function() { vm.viewportWidth = window.innerWidth; };
        window.addEventListener('resize', this.onViewport);
        this.placePanes();
    },
    updated: function() { this.placePanes(); },
    beforeDestroy: function() {
        if (this.onViewport) window.removeEventListener('resize', this.onViewport);
        this.cancelTurn();
        if (this.recognition && this.recognizing) try { this.recognition.stop(); } catch (e) { /* ignore */ }
    }
};
</script>
<style>
.assist-root { min-height: 60vh; position: relative; }
.assist-conv-backdrop { position: absolute; inset: 0; z-index: 15; background: rgba(0,0,0,0.12); }
.assist-conv-drawer {
    position: absolute; top: 0; bottom: 0; width: 320px; max-width: 92%; z-index: 16;
    background: #fff; box-shadow: 0 0 16px rgba(0,0,0,0.18); display: flex;
}
.assist-conv-left { left: 0; }
.assist-conv-right { right: 0; }
.assist-pane-host { height: 100%; min-height: 0; }
.assist-pane-holder { display: none; }
.assist-split-flip .assist-chat { border-right: none; border-left: 1px solid rgba(0,0,0,0.08); }
.assist-mobile-chat .q-splitter__separator,
.assist-mobile-chat .q-splitter__after { display: none; }
.assist-mobile-chat .q-splitter__before { width: 100% !important; max-width: 100% !important; }
.assist-mobile-screen .q-splitter__separator,
.assist-mobile-screen .q-splitter__before { display: none; }
.assist-mobile-screen .q-splitter__after { width: 100% !important; max-width: 100% !important; }
.assist-conv-row { border-bottom: 1px solid rgba(0,0,0,0.06); }
.assist-conv-open { background: rgba(25, 118, 210, 0.08); }
.assist-source-pre {
    margin: 0; max-height: 40vh; overflow: auto; white-space: pre-wrap; word-break: break-word;
    background: #f5f5f5; padding: 8px; border-radius: 4px; font-size: 12px;
}
.assist-pane { height: 100%; overflow: hidden; }
.assist-chat { border-right: 1px solid rgba(0,0,0,0.08); }
/* qapps does not load webroot-theme.css, so the shared .spinner rules never apply here.
   The marks stay drawn; only the rotation waits for the model connection. */
@keyframes assist-spin { to { transform: rotate(1turn); } }
.assist-chat .assist-wait {
    position: relative; display: inline-block; width: 18px; height: 18px; overflow: hidden;
    animation: assist-spin 0.9s infinite steps(8); animation-play-state: paused;
}
.assist-chat .assist-wait.assist-wait-go { animation-play-state: running; }
.assist-chat .assist-wait:before, .assist-chat .assist-wait:after,
.assist-chat .assist-wait > div:before, .assist-chat .assist-wait > div:after {
    content: ''; position: absolute; top: 0; left: 7.5px; width: 3px; height: 5px; border-radius: 1px;
    background: #555; box-shadow: 0 13px #ccc; transform-origin: 50% 9px;
}
.assist-chat .assist-wait:after { transform: rotate(-45deg); background: #777; }
.assist-chat .assist-wait > div:before { transform: rotate(-90deg); background: #999; }
.assist-chat .assist-wait > div:after { transform: rotate(-135deg); background: #bbb; }
/* Gutter classes use a negative margin, which overflow:auto clips. Gap keeps the first control's border inside the scrollport. */
.assist-canvas-body { padding: 12px 16px 24px; box-sizing: border-box; }
.assist-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 16px; }
</style>
