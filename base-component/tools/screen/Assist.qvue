            var s = this.schema;
            if (!s || s.kind !== 'openui' || s.lang) return false;
            var fields = s.fields || [];
            var acts = s.actions || [];
            return fields.length > 0 || acts.length > 0 || !!s.submitLabel;
        },
        showParentSubmit: function() {
            if (!this.schema) return false;
            if (this.schema.kind === 'openui' && !this.formShapedOpenUi) return false;
            return true;
        },
        visibleFields: function() {
            var fields = (this.schema && this.schema.fields) || [];
            return fields.filter(function(f) { return f && f.widget !== 'hidden'; });
        },
        primaryLabel: function() {
            var s = this.schema || {};
            var acts = s.actions || [];
            var p = acts.filter(function(a) { return a.primary; })[0];
