<template>
<div class="assist-root">
    <div class="row items-center q-mb-sm q-col-gutter-sm">
        <div class="col-auto">
            <q-btn-toggle dense unelevated v-model="writeMode" :options="writeModeOptions"
                          toggle-color="primary" @input="persistWriteMode"></q-btn-toggle>
        </div>
        <div class="col-auto">
            <q-toggle dense v-model="forceSkillUse" label="Force Skill Use"
                      @input="persistForceSkillUse"></q-toggle>
        </div>
        <div class="col text-caption text-grey-7">{{ writeModeHint }}</div>
        <div class="col-auto">
            <q-btn dense outline no-caps :label="chatOnLeft ? 'Chat | Screen' : 'Screen | Chat'"
                   @click="toggleSide"></q-btn>
        </div>
        <div class="col-auto">
            <q-btn id="assist-conversations" dense outline no-caps icon="history" label="Chats"
                   @click="toggleConvDrawer"></q-btn>
        </div>
        <div class="col-auto">
            <q-btn id="assist-source" dense outline no-caps icon="open_in_new" label="Source" :disable="!schema"
                   @click="sourceOpen = true"></q-btn>
        </div>
        <div class="col-auto">
            <q-btn dense outline no-caps label="New" @click="newSession"></q-btn>
        </div>
        <div class="col-auto">
            <q-btn dense outline no-caps color="negative" label="Cancel" :disable="!streaming" @click="cancelTurn"></q-btn>
        </div>
    </div>
    <q-tabs v-if="isMobile" v-model="mobileTab" dense class="text-primary">
        <q-tab name="chat" label="Chat"></q-tab>
        <q-tab name="screen" label="Screen"></q-tab>
    </q-tabs>
    <q-splitter v-model="splitterPct" class="assist-split" :class="splitClass" style="height: calc(100vh - 140px)">
        <template v-slot:before>
            <div ref="paneBefore" class="assist-pane-host"></div>
        </template>
        <template v-slot:after>
            <div ref="paneAfter" class="assist-pane-host"></div>
        </template>
    </q-splitter>
    <!-- Quasar sizes the before panel and treats it as the left side. The panes are moved into
         that order so a rightward drag grows the left pane. Row-reverse made the drag run backwards. -->
    <div ref="paneHolder" class="assist-pane-holder">
            <div ref="chatPane" class="assist-pane assist-chat q-pa-sm column" style="height:100%">
                <div class="col overflow-auto" style="min-height:0">
                    <div v-for="(m, i) in messages" :key="i" class="q-mb-sm">
                        <div v-if="m.role!=='tool' && m.role!=='done'" class="text-caption text-grey-7">{{ m.role }}<span v-if="m.name"> {{ m.name }}</span></div>
                        <div v-if="m.role==='tool'" class="text-caption">{{ m.kind }} {{ m.name }}<span v-if="toolSummary(m)"> — {{ toolSummary(m) }}</span></div>
                        <div v-else-if="m.role==='done'" class="text-caption text-grey-7">{{ m.content }}</div>
                        <div v-else-if="m.pending && !String(m.content || '').trim()"
                             class="assist-wait" :class="{ 'assist-wait-go': m.connected }" role="status"
                             :aria-label="m.connected ? 'Waiting for the model' : 'Connecting'"><div></div></div>
                        <div v-else style="white-space:pre-wrap">{{ m.content }}</div>
                    </div>
                </div>
                <div class="col-auto q-pt-sm">
                    <q-input id="assist-composer" outlined autogrow v-model="composer" placeholder="Describe what you need"
                             @keyup.enter.exact.prevent="send" :disable="streaming">
                        <template v-slot:append>
                            <q-btn v-if="speechSupported" flat round dense :icon="recognizing ? 'mic' : 'mic_none'"
                                   @click="toggleMic"></q-btn>
                            <q-btn id="assist-send" flat round dense icon="send" :disable="streaming || !composer"
                                   @click="send"></q-btn>
                        </template>
                    </q-input>
                </div>
            </div>
            <div ref="canvasPane" class="assist-pane assist-canvas column" style="height:100%">
                <div v-if="pendingConfirm()" class="q-pa-md">
                    <div class="text-subtitle1">Confirm this action</div>
                    <div class="text-body2 q-mb-md" style="white-space:pre-wrap">{{ confirmSummary(pendingConfirm()) }}</div>
                    <div class="assist-actions">
                        <q-btn id="assist-confirm" unelevated color="primary" no-caps label="Confirm"
                               :disable="streaming" @click="confirmTool(true)"></q-btn>
                        <q-btn id="assist-confirm-cancel" outline no-caps label="Cancel"
                               :disable="streaming" @click="confirmTool(false)"></q-btn>
                    </div>
                </div>
                <div v-if="!schema && !pendingConfirm()" class="text-grey-7 q-pa-md">
                    Describe what you need. Assist will build a screen here.</div>
                <div v-else-if="schema" class="col overflow-auto assist-canvas-body">
                    <div class="text-h6">{{ schema.title }}</div>
                    <div v-if="schema.instruction" class="text-body2 q-mb-md">{{ schema.instruction }}</div>
                    <div v-if="schema.langError && !showOpenUi && !showFormWidgets" class="text-negative q-mb-md">{{ schema.langError }}</div>
                    <div v-if="(schema.actions||[]).length" class="q-mb-md">
                        <div class="text-subtitle2">On submit</div>
                        <ul class="q-pl-md">
                            <li v-for="a in schema.actions" :key="a.id">
                                {{ a.label || a.id }} — {{ a.method }} {{ a.path }}</li>
                        </ul>
                    </div>
                    <div v-if="showOpenUi" class="q-mb-md">
                        <assist-openui :lang="schema.lang" :streaming="streaming" :mode="writeMode"
                                       :csrf="csrf" :app-root="($root && $root.appRootPath) || ''"
                                       :initial-state="fieldValues"
                                       @action="onOpenUiAction" @state-update="onOpenUiState"
                                       @error="onOpenUiError" @request-notice="onOpenUiRequestNotice"></assist-openui>
                    </div>
                    <div v-if="showVueSfc" class="q-mb-md">
                        <component :is="vueSfcComp" :key="vueSfcKey"
                                   :values="fieldValues" :schema="schema" :mode="writeMode"
                                   @input="onSfcInput" @submit="onSfcSubmit" @cancel="newSession"></component>
                    </div>
                    <div v-else-if="schema.kind==='vue-sfc' && !vueSfcFailed" class="text-grey-7 q-mb-md">
                        Loading generated screen…</div>
                    <div v-if="showFormWidgets && (schema.columns||[]).length" class="q-mb-md">
                        <table class="q-table">
                            <thead><tr>
                                <th v-for="c in schema.columns" :key="c.name">{{ c.label || c.name }}</th>
                            </tr></thead>
                            <tbody>
                                <tr v-for="(row, ri) in (schema.rows||[])" :key="ri">
                                    <td v-for="c in schema.columns" :key="c.name">{{ row[c.name] }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div v-if="showFormWidgets" v-for="f in visibleFields" :key="f.name" class="q-mb-sm" :data-field="f.name">
                        <m-text-line v-if="f.widget==='text-line' || f.widget==='hidden'" dense outlined
                                     :label="f.label || f.name" :value="fieldValues[f.name]"
                                     @input="onFieldInput(f.name, $event)"
                                     :type="f.widget==='hidden' ? 'hidden' : 'text'"
                                     :name="f.name"
                                     :tooltip="f.help"></m-text-line>
                        <q-input v-else-if="f.widget==='text-area'" dense outlined autogrow type="textarea"
                                 stack-label :label="f.label || f.name" :value="fieldValues[f.name]"
                                 @input="onFieldInput(f.name, $event)" :hint="f.help" :name="f.name"></q-input>
                        <q-select v-else-if="f.widget==='drop-down' && (f.options||[]).length" dense outlined emit-value map-options
                                  :options="f.options || []" option-value="key" option-label="text"
                                  stack-label :label="f.label || f.name" :value="fieldValues[f.name]"
                                  @input="onFieldInput(f.name, $event)"></q-select>
                        <m-text-line v-else-if="f.widget==='drop-down'" dense outlined
                                     :label="f.label || f.name" :value="fieldValues[f.name]"
                                     @input="onFieldInput(f.name, $event)" :name="f.name"
                                     :tooltip="f.help"></m-text-line>
                        <m-date-time v-else-if="f.widget==='date-time'" :name="f.name" :label="f.label || f.name"
                                     :type="f.widgetType || 'date-time'" :value="fieldValues[f.name]"
                                     @input="onFieldInput(f.name, $event)"></m-date-time>
                        <q-checkbox v-else-if="f.widget==='check'" :label="f.label || f.name"
                                    :value="fieldValues[f.name]"
                                    @input="onFieldInput(f.name, $event)"></q-checkbox>
                        <div v-else-if="f.widget==='radio'">
                            <div class="text-caption text-grey-7">{{ f.label || f.name }}</div>
                            <q-option-group dense type="radio" :value="fieldValues[f.name]"
                                            :options="radioOptions(f)"
                                            @input="onFieldInput(f.name, $event)"></q-option-group>
                        </div>
                        <div v-else class="text-body2"><span class="text-grey-7">{{ f.label || f.name }}:</span> {{ fieldValues[f.name] }}</div>
                    </div>
                    <div v-if="canvasNotices.length" id="assist-canvas-notices" class="q-mb-md">
                        <div class="text-subtitle2">Problems with this screen</div>
                        <ul class="q-pl-md q-mb-none">
                            <li v-for="(n, ni) in canvasNotices" :key="'cn'+ni"
                                :class="n.kind==='error' ? 'text-negative' : ''">{{ n.message }}<span v-if="n.count && n.count > 1"> (×{{ n.count }})</span></li>
                        </ul>
                    </div>
                    <div v-if="showParentSubmit" class="assist-actions">
                        <q-btn id="assist-submit" unelevated color="primary" no-caps
                               :label="primaryLabel" :disable="streaming"
                               @click="submitCanvas(primaryId)"></q-btn>
                        <q-btn id="assist-adjust" outline no-caps icon="open_in_new" label="Adjust"
                               :disable="streaming || !!pendingConfirm()" @click="adjustOpen = true"></q-btn>
                        <q-btn outline no-caps :label="schema.cancelLabel || 'Cancel'"
                               @click="newSession"></q-btn>
                    </div>
                    <div v-else class="assist-actions">
                        <q-btn id="assist-adjust" outline no-caps icon="open_in_new" label="Adjust"
                               :disable="streaming || !!pendingConfirm()" @click="adjustOpen = true"></q-btn>
                        <q-btn outline no-caps :label="schema.cancelLabel || 'Cancel'"
                               @click="newSession"></q-btn>
                    </div>
                </div>
            </div>
    </div>
    <q-dialog id="assist-adjust-dialog" v-model="adjustOpen">
        <q-card style="min-width:360px; max-width:560px; width:92vw">
            <q-card-section>
                <div class="text-h6">Adjust this screen</div>
            </q-card-section>
            <q-card-section class="q-pt-none">
                <div class="text-body2 q-mb-md">Describe what to change, or what is not working. Assist will revise the screen that is on the canvas now. This does not submit the form.</div>
                <div v-if="canvasNotices.length" class="q-mb-md">
                    <div class="text-subtitle2">Problems with this screen</div>
                    <ul class="q-pl-md q-mb-none">
                        <li v-for="(n, ni) in canvasNotices" :key="ni"
                            :class="n.kind==='error' ? 'text-negative' : ''">{{ n.message }}<span v-if="n.count && n.count > 1"> (×{{ n.count }})</span></li>
                    </ul>
                </div>
                <q-input id="assist-adjust-text" outlined autogrow type="textarea" v-model="adjustText"
                         placeholder="What should be different?"></q-input>
            </q-card-section>
            <q-card-actions align="right">
                <q-btn flat no-caps label="Cancel" v-close-popup></q-btn>
                <q-btn id="assist-adjust-submit" unelevated color="primary" no-caps label="Adjust"
                       :disable="streaming || !(adjustText && adjustText.trim())" @click="submitAdjust"></q-btn>
            </q-card-actions>
        </q-card>
    </q-dialog>
    <div v-if="convDrawer" class="assist-conv-backdrop" @click="convDrawer = false"></div>
    <div v-if="convDrawer" id="assist-conv-drawer" class="assist-conv-drawer column"
         :class="chatOnLeft ? 'assist-conv-left' : 'assist-conv-right'">
        <div class="row items-center q-pa-sm">
            <div class="col text-subtitle1">Chats</div>
            <q-btn flat round dense icon="close" @click="convDrawer = false"></q-btn>
        </div>
        <div class="q-px-sm q-pb-sm">
            <q-input id="assist-conv-search" dense outlined v-model="convSearch"
                     placeholder="Search (3+ letters for the message)" @input="onConvSearch"></q-input>
        </div>
        <div class="col overflow-auto">
            <div v-if="!conversations.length" class="text-grey-7 q-pa-md">No conversations</div>
            <div v-for="row in conversations" :key="row.conversationId"
                 class="assist-conv-row q-px-sm q-py-xs cursor-pointer"
                 :class="{ 'assist-conv-open': row.conversationId === conversationId }"
                 @click="openConversation(row.conversationId)">
                <div class="row items-start no-wrap">
                    <div class="col">
                        <div class="text-body2">{{ row.summary || row.title || 'New conversation' }}</div>
                        <div class="text-caption text-grey-7">
                            Started {{ formatWhen(row.createdDate) }}
                            <span v-if="row.lastMessageDate"> · Updated {{ formatWhen(row.lastMessageDate) }}</span>
                        </div>
                        <div class="text-caption text-grey-7">
                            {{ convStatusLabel(row.status) }}
                            <span v-if="row.messageCount != null"> · {{ row.messageCount }} messages</span>
                            <span v-if="row.hasCanvas"> · Canvas</span>
                        </div>
                    </div>
                    <q-btn flat round dense icon="delete" color="negative"
                           :disable="streaming && row.conversationId === conversationId"
                           @click.stop="askDelete(row)"></q-btn>
                </div>
            </div>
        </div>
        <div v-if="convPages > 1" class="row justify-center q-pa-sm">
            <q-pagination :value="convPageIndex + 1" :max="convPages" :max-pages="6" direction-links
                          @input="onConvPage"></q-pagination>
        </div>
    </div>
    <q-dialog id="assist-source-dialog" v-model="sourceOpen">
        <q-card style="min-width:360px; max-width:720px; width:92vw">
            <q-card-section>
                <div class="text-h6">Canvas source</div>
            </q-card-section>
            <q-card-section class="q-pt-none">
                <div class="row items-center q-mb-xs">
                    <div class="col text-subtitle2">Source</div>
                    <q-btn flat dense no-caps label="Copy" :disable="!sourceText" @click="copyText(sourceText)"></q-btn>
                </div>
                <pre class="assist-source-pre">{{ sourceText || 'No source' }}</pre>
                <div v-if="submitScriptText" class="q-mt-md">
                    <div class="row items-center q-mb-xs">
                        <div class="col text-subtitle2">Submit script</div>
                        <q-btn flat dense no-caps label="Copy" @click="copyText(submitScriptText)"></q-btn>
                    </div>
                    <pre class="assist-source-pre">{{ submitScriptText }}</pre>
                </div>
            </q-card-section>
            <q-card-actions align="right">
                <q-btn flat no-caps label="Close" v-close-popup></q-btn>
            </q-card-actions>
        </q-card>
    </q-dialog>
    <q-dialog v-model="deleteOpen">
        <q-card style="min-width:320px">
            <q-card-section>
                <div class="text-h6">Delete conversation</div>
            </q-card-section>
            <q-card-section class="q-pt-none">{{ deletePrompt }}</q-card-section>
            <q-card-actions align="right">
                <q-btn flat no-caps label="Cancel" v-close-popup></q-btn>
                <q-btn id="assist-conv-delete" unelevated color="negative" no-caps label="Delete"
                       @click="deleteConversation"></q-btn>
            </q-card-actions>
        </q-card>
    </q-dialog>
</div>
</template>
<script>
/* Assist Universal Screen. Canvas kinds: form spec, vue-sfc (httpVueLoader.parse).
 * FUTURE: screen-xml POST to a compile/render transition (server round-trip).
 */
function parseSseChunk(buffer, onEvent) {
    var parts = buffer.split('\n\n');
    var rest = parts.pop();
    for (var i = 0; i < parts.length; i++) {
        var block = parts[i];
        if (!block || !block.trim()) continue;
        var event = 'message', data = '';
        var lines = block.split('\n');
        for (var j = 0; j < lines.length; j++) {
            var line = lines[j];
            if (line.indexOf('event:') === 0) event = line.slice(6).trim();
            else if (line.indexOf('data:') === 0) data += line.slice(5).trim();
        }
        var parsed = data;
        try { parsed = JSON.parse(data); } catch (e) { /* keep string */ }
        onEvent(event, parsed);
    }
    return rest;
}
var CONV_STORAGE_KEY = 'assist.conversationId';
function formatWhen(ms) {
    if (ms == null || ms === '') return '';
    var n = typeof ms === 'number' ? ms : Number(ms);
    if (!n) return '';
    try { return new Date(n).toLocaleString(); } catch (e) { return ''; }
}
function convStatusLabel(status) {
    if (!status) return '';
    return String(status).replace(/^Llmcs/, '');
}
function historyToMessages(history) {
    var out = [];
    (history || []).forEach(function(m) {
        if (!m || m.role === 'system' || m.role === 'context') return;
        if (m.role === 'tool') {
            out.push({ role: 'tool', kind: 'result', name: m.name, content: m.content, toolCallId: m.toolCallId });
            return;
        }
        if (m.role === 'assistant' && m.toolCalls && m.toolCalls.length) {
            if (m.content) out.push({ role: 'assistant', content: m.content });
            m.toolCalls.forEach(function(c) {
                if (!c) return;
                out.push({ role: 'tool', kind: 'call', name: c.name, arguments: c.arguments, summary: c.summary });
            });
            return;
        }
        out.push({ role: m.role, content: m.content || '', name: m.name });
    });
    return out;
}
function canvasSourceText(schema) {
    if (!schema) return '';
    if (schema.lang) return schema.lang;
    if (schema.kind === 'vue-sfc') return assembleSfc(schema);
    var rows = schema.rows || [];
    var copy = {
        kind: schema.kind, title: schema.title, instruction: schema.instruction,
        fields: schema.fields, columns: schema.columns, actions: schema.actions
    };
    if (rows.length > 20) {
        copy.rows = rows.slice(0, 20);
        copy.rowsOmitted = rows.length - 20;
    } else if (rows.length) copy.rows = rows;
    return JSON.stringify(copy, null, 2);
}
function canvasSubmitText(schema) {
    if (!schema) return '';
    var parts = [];
    var assembled = schema.kind === 'vue-sfc' ? assembleSfc(schema) : '';
    if (schema.script && assembled.indexOf(schema.script) < 0) parts.push(schema.script);
    (schema.actions || []).forEach(function(a) {
        if (!a) return;
        var line = (a.method || '') + ' ' + (a.path || '');
        if (a.body) line += '\n' + JSON.stringify(a.body, null, 2);
        else if (a.bodyFromFields && a.bodyFromFields.length)
            line += '\nbodyFromFields: ' + a.bodyFromFields.join(', ');
        parts.push(line.trim());
    });
    return parts.filter(function(p) { return p; }).join('\n\n');
}
var HTML_ACTION_ERROR = 'HTML screens are not valid tool results. Use /apps (not /qapps). GET {screen}/actions for screen JSON, GET {screen}/actions/{formListName} for form-list rows (browse jsonPath), or POST {screen}/{transitionName} for a named transition from browse (not /actions/{transition})';
var ADJUST_INSTRUCTION = 'The user wants this screen changed or fixed. Do not submit it and do not run its actions. Call write_ui again so the screen matches the feedback. canvas is the screen they are looking at now, including field values they typed. notices are render errors and server messages from canvas requests (validation errors, service errors, warnings); fix those too. A validation error means the value sent was rejected: drop a timestamp the service defaults, or send YYYY-MM-DD HH:mm. For a small OpenUI change, set writeThrough true and send only the changed statements. If the screen failed to render or the structure is wrong, send a full lang program.';
/** Same rules as AssistOpenUi.js screenResponseProblems. A transition can return HTTP 200 plus screenUrl when the service rejected the input. */
function screenResponseProblems(parsed) {
    if (typeof window.assistScreenResponseProblems === 'function')
        return window.assistScreenResponseProblems(parsed);
    var errors = [];
    var warnings = [];
    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed))
        return { errors: errors, warnings: warnings };
    var val = parsed.validationErrors;
    if (Array.isArray(val)) {
        for (var i = 0; i < val.length; i++) {
            var ve = val[i] || {};
            var msg = ve.message ? String(ve.message) : 'Validation error';
            var field = ve.fieldPretty || ve.field;
            var svc = ve.serviceNamePretty || ve.serviceName;
            var extra = [];
            if (field) extra.push('for field ' + field);
            if (svc) extra.push('of service ' + svc);
            if (extra.length) msg += ' (' + extra.join(' ') + ')';
            errors.push(msg);
        }
    }
    var errs = parsed.errors;
    if (Array.isArray(errs)) {
        for (var e = 0; e < errs.length; e++) if (errs[e]) errors.push(String(errs[e]));
    }
    var infos = parsed.messageInfos;
    if (Array.isArray(infos)) {
        for (var m = 0; m < infos.length; m++) {
            var info = infos[m] || {};
            if (!info.message) continue;
            var type = String(info.type || '').toLowerCase();
            if (type === 'danger' || type === 'error') errors.push(String(info.message));
            else if (type === 'warning') warnings.push(String(info.message));
        }
    }
    return { errors: errors, warnings: warnings };
}
var RESPONSE_ENVELOPE = { screenPathList: 1, screenParameters: 1, screenUrl: 1, redirectUrl: 1,
    currentParameters: 1, messageInfos: 1, errors: 1, validationErrors: 1 };
function isHtmlBody(text, contentType) {
    if (contentType && String(contentType).toLowerCase().indexOf('html') >= 0) return true;
    if (text == null) return false;
    var t = String(text).trim();
    if (!t) return false;
    var head = t.length > 32 ? t.slice(0, 32).toLowerCase() : t.toLowerCase();
    return head.indexOf('<!doctype') === 0 || head.indexOf('<html') === 0
        || head.indexOf('<body') === 0 || head.indexOf('<head') === 0;
}
function validateActionPath(path) {
    if (window.AssistOpenUiNav && typeof window.AssistOpenUiNav.validatePath === 'function')
        return window.AssistOpenUiNav.validatePath(path);
    if (!path || path.charAt(0) !== '/') return 'path must start with /';
    if (/[\s\\\u0000-\u001f]/.test(path)) return 'path must not contain whitespace or backslash';
    if (path.indexOf('://') >= 0 || path.indexOf('//') === 0) return 'path must not contain a host';
    if (path.indexOf('..') >= 0) return 'path must not contain ..';
    var lower = String(path).toLowerCase();
    if (lower.indexOf('javascript:') >= 0 || lower.indexOf('data:') >= 0) return 'path scheme not allowed';
    return null;
}
function unescapeHtml(s) {
    if (s == null || s === '') return s;
    return String(s).replace(/&amp;/g, '&').replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
}
function scalarValue(v) {
    if (v == null) return '';
    if (typeof v === 'object') {
        if (v.value != null && typeof v.value !== 'object') return unescapeHtml(String(v.value));
        var keys = Object.keys(v);
        if (keys.length === 1 && typeof v[keys[0]] !== 'object') return unescapeHtml(String(v[keys[0]]));
        return '';
    }
    return unescapeHtml(String(v));
}
function assistDateKind(type) {
    return (type === 'date' || type === 'time') ? type : 'date-time';
}
function assistDateMatches(text, kind) {
    if (kind === 'date') return /^\d{4}-\d{2}-\d{2}$/.test(text);
    if (kind === 'time') return /^\d{2}:\d{2}$/.test(text);
