<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Assist" menu-image="fa fa-comments" menu-image-type="icon"
        render-modes="vue,qvue" server-static="vue,qvue">

    <pre-actions><script><![CDATA[
        if (footer_scripts != null) {
            footer_scripts.add('/js/assist/lang-core.umd.min.js')
            footer_scripts.add('/js/assist/AssistOpenUiLibrary.js')
            footer_scripts.add('/js/assist/AssistOpenUi.js')
        }
    ]]></script></pre-actions>

    <transition name="setTitle" method="post">
        <parameter name="conversationId" required="true"/>
        <parameter name="title"/>
        <actions>
            <if condition="!ec.user.hasPermission('LlmGateway')">
                <return error="true" message="User does not have permission to use Assist"/></if>
            <script><![CDATA[
            def conv = ec.llm.getConversation(conversationId)
            if (conv != null && title) conv.setTitle(title)
            ec.web.sendJsonResponse([conversationId: conversationId, title: title])
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <if condition="!ec.user.hasPermission('LlmGateway')">
            <return error="true" message="User does not have permission to use Assist"/></if>
    </actions>
    <widgets>
        <render-mode>
            <text type="qvue" location="component://tools/screen/Assist.qvue" template="false"/>
            <text type="html,vuet"><![CDATA[
                <p><strong>Only supported under /qapps (Quasar UI). Open the same path under /qapps/assist.</strong></p>
            ]]></text>
        </render-mode>
    </widgets>
</screen>
