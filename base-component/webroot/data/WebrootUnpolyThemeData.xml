<entity-facade-xml type="seed-initial">
    <!-- Enum type entry for the Unpoly screen theme type -->
    <moqui.basic.Enumeration description="Internal Applications - Unpoly" enumId="STT_INTERNAL_UNPOLY" 
            enumTypeId="ScreenThemeType" sequenceNum="40"/>

    <!-- Unpoly Paper Style theme record -->
    <moqui.screen.ScreenTheme screenThemeId="UNPOLY" screenThemeTypeEnumId="STT_INTERNAL_UNPOLY"
            description="Moqui Unpoly + Bootstrap 5 Theme"/>

    <!-- CSS: Font Awesome 6 -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="2" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/font-awesome/css/all.min.css"/>
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="11" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/font-awesome/css/v4-shims.min.css"/>
    <!-- Bootstrap 5 -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="3" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/bootstrap5/css/bootstrap.min.css"/>
    <!-- Bootstrap Datetimepicker -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="4" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css"/>
    <!-- Select2 -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="5" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/select2/css/select2.min.css"/>
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="6" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/select2-bootstrap-theme/select2-bootstrap.min.css"/>
    <!-- Selectivity -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="7" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/Selectivity.js/selectivity-full.min.css"/>
    <!-- jsTree -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="8" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/jstree/themes/default/style.min.css"/>
    <!-- Unpoly -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="9" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/libs/unpoly/unpoly.css"/>

    <!-- Placeholder for an optional external theme override -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="10" resourceTypeEnumId="STRT_STYLESHEET" resourceValue=""/>

    <!-- Unpoly layout (topbar, page shell, widgets) -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="20" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/css/unpoly-layout.css"/>
    <!-- Unpoly Paper Style visual theme -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="21" resourceTypeEnumId="STRT_STYLESHEET"
            resourceValue="/css/unpoly-paper.css"/>

    <!-- Logo, icon, body class -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="100" resourceTypeEnumId="STRT_HEADER_LOGO"
            resourceValue="/images/MoquiLogoSmall.png"/>
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="101" resourceTypeEnumId="STRT_SHORTCUT_ICON"
            resourceValue="/favicon.ico"/>
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="102" resourceTypeEnumId="STRT_BODY_CLASS"
            resourceValue="bg-light"/>

    <!-- Footer items -->
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="200" resourceTypeEnumId="STRT_FOOTER_ITEM">
        <resourceValue><![CDATA[<p><a href="https://www.moqui.org/" target="_blank">${ec.resource.expand('Built on Moqui Framework ${ec.factory.moquiVersion}', '')}</a></p>]]></resourceValue>
    </moqui.screen.ScreenThemeResource>
    <moqui.screen.ScreenThemeResource screenThemeId="UNPOLY" sequenceNum="201" resourceTypeEnumId="STRT_FOOTER_ITEM">
        <resourceValue><![CDATA[<p><a href="/uapps/ScreenTree">${ec.l10n.localize('Site Map')}</a></p>]]></resourceValue>
    </moqui.screen.ScreenThemeResource>
</entity-facade-xml>
