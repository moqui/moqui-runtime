<entity-facade-xml type="seed">
    <!-- Set enumCode so Moqui can resolve the UNPOLY theme for STT_INTERNAL_UNPOLY (see ScreenRenderImpl.getCurrentThemeId) -->
    <moqui.basic.Enumeration enumId="STT_INTERNAL_UNPOLY" enumTypeId="ScreenThemeType" enumCode="UNPOLY"
            description="Internal Applications - Unpoly" sequenceNum="40"/>

    <!-- Grant all users access to the Unpoly UI screens (mirrors apps/ entries in WebrootSecurityData.xml) -->
    <moqui.security.ArtifactGroupMember artifactGroupId="SCREEN_TREE" artifactName="component://webroot/screen/webroot/uapps.xml"
            artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="SCREEN_TREE" artifactName="component://webroot/screen/webroot/uapps/AppList.xml"
            artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="SCREEN_TREE" artifactName="component://webroot/screen/webroot/uapps/ScreenTree.xml"
            artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
</entity-facade-xml>
